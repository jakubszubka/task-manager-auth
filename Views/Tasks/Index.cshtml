@{
}

@model IEnumerable<TaskManagerAuth.Models.TodoTask>

<h1 class="mb-4">My Tasks</h1>

<a class="btn btn-primary mb-3" asp-action="Create">Create New Task</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Title</th>
            <th>Description</th>
            <th>Due Date</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var task in Model)
        {
            <tr>
                <td>@task.Title</td>
                <td>@task.Description</td>
                <td>@task.DueDate?.ToShortDateString()</td>
                <td>@(task.IsCompleted ? "✔ Completed" : "❌ Pending")</td>
                <td>
                    <a class="btn btn-sm btn-warning" asp-action="Edit" asp-route-id="@task.Id">Edit</a>
                    <a class="btn btn-sm btn-danger" asp-action="Delete" asp-route-id="@task.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>