@{
}

@model TaskManagerAuth.Models.TodoTask

<h1 class="mb-3">Edit Task</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="All"></div>

    <div class="mb-3">
        <label class="form-label" asp-for="Title"></label>
        <input class="form-control" asp-for="Title" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="Description"></label>
        <input class="form-control" asp-for="Description" />
    </div>

    <div class="mb-3">
        <label class="form-label" asp-for="DueDate"></label>
        <input class="form-control" asp-for="DueDate" />
    </div>

    <div class="mb-3">
        <label class="form-check-label" asp-for="IsCompleted"></label>
        <input class="form-check-input" asp-for="IsCompleted" />
    </div>

    @Html.AntiForgeryToken()

    <button class="btn btn-primary" type="submit">Save</button>
    <a class="btn btn-secondary" asp-action="Index">Back</a>

</form>